# Prevent script execution in uploads directory
# Any PHP or executable file requested directly will be denied execution
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|asp|js|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP engine if running Apache mod_php
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
